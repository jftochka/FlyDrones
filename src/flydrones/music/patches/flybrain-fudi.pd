#N canvas 30 30 980 700 12;
#X text 20 20 FlyDrones - a fruit fly brain playing a drone \, into Pure Data.;
#X text 20 38 flydrones compose --to pd-fudi   (FUDI on port 3001);
#X text 20 56 The synth on the right is a two-oscillator monosynth \, so that you hear;
#X text 20 74 something at once. The messages are the point: send them wherever you like.;
#X obj 30 130 netreceive -u 3001;
#X text 210 133 FUDI: the messages are readable in the Pd window;
#X obj 30 250 route note ctrl section frame;
#X connect 4 0 6 0;
#X obj 30 300 unpack s s f f f f f f f f;
#X connect 6 0 7 0;
#X text 320 302 voice sound note velocity duration pan channel orbit rate_hz delay_ms;
#X obj 700 250 print fly;
#X connect 6 2 9 0;
#X connect 6 3 9 0;
#X obj 700 190 spigot;
